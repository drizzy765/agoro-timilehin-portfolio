{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers (free plan). URL: https://timis.tech (also https://drizzy.agoro-timilehin.workers.dev)
  // Pages are a static Next.js export (out/) served by Workers Static Assets: no worker CPU per page.
  // The worker runs first on every request but only does a host check (www.timis.tech -> timis.tech)
  // and /api/chat; everything else is passed straight to static assets (negligible CPU).
  "name": "drizzy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "minify": true,
  "preview_urls": false,
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Secrets (not in this file): `printf '%s' "$GROQ_API_KEY" | npx wrangler secret put GROQ_API_KEY`
  // NEXT_PUBLIC_SITE_URL is inlined at BUILD time (npm run deploy sets it).
  "observability": { "enabled": true }
}
